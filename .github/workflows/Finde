name: Analyze disp_rdump_memory

on:
  workflow_dispatch:

jobs:
  analyze:
    runs-on: ubuntu-22.04

    steps:

      - name: Checkout kernel source
        uses: actions/checkout@v4
        with:
          ref: 16
          fetch-depth: 1

      - name: Fast source analysis
        run: |
          set -e

          REPORT="disp_rdump_memory_report.txt"

          {
            echo "========================================"
            echo "disp_rdump_memory FAST ANALYSIS"
            echo "========================================"
            echo
            echo "COMMIT: $(git rev-parse HEAD)"
            echo

            echo "========================================"
            echo "[1] ALL REFERENCES"
            echo "========================================"
            git grep -n "disp_rdump_memory" -- \
              '*.dts' '*.dtsi' || true
            echo

            echo "========================================"
            echo "[2] EXACT LABEL DEFINITIONS"
            echo "========================================"
            git grep -n -E 'disp_rdump_memory[[:space:]]*:' -- \
              '*.dts' '*.dtsi' || true
            echo

            echo "========================================"
            echo "[3] DTS REFERENCES"
            echo "========================================"
            git grep -n -E '&disp_rdump_memory([[:space:];,}]|$)' -- \
              '*.dts' '*.dtsi' || true
            echo

            echo "========================================"
            echo "[4] VIOLET MEMORY DTSI"
            echo "========================================"
            FILE="arch/arm64/boot/dts/qcom/xiaomi/violet/violet-sm6150-memory.dtsi"

            if [ -f "$FILE" ]; then
              echo "FILE: $FILE"
              echo
              nl -ba "$FILE" | sed -n '1,100p'
            else
              echo "NOT FOUND: $FILE"
            fi
            echo

            echo "========================================"
            echo "[5] VIOLET INCLUDE CHAIN"
            echo "========================================"
            git grep -n "violet-sm6150-memory.dtsi" -- \
              '*.dts' '*.dtsi' || true
            echo

            echo "========================================"
            echo "[6] RELATED MEMORY LABELS"
            echo "========================================"
            git grep -n -E \
              '(dfps_data_memory|rdump_memory|disp_.*memory)[[:space:]]*:' -- \
              '*.dts' '*.dtsi' || true
            echo

            echo "========================================"
            echo "END OF REPORT"
            echo "========================================"

          } > "$REPORT"

          cat "$REPORT"

      - name: Upload report
        uses: actions/upload-artifact@v4
        with:
          name: disp-rdump-memory-analysis
          path: disp_rdump_memory_report.txt
          if-no-files-found: error
