name: VIOLET Fast Deep Joker Audit

on:
  workflow_dispatch:

jobs:
  audit:
    runs-on: ubuntu-22.04

    steps:

      - name: Checkout VIOLET kernel
        uses: actions/checkout@v4
        with:
          ref: 16
          fetch-depth: 1

      - name: Install dependencies
        run: |
          set -e

          sudo apt-get update

          sudo apt-get install -y \
            bc \
            bison \
            flex \
            libssl-dev \
            libelf-dev \
            make \
            gcc-aarch64-linux-gnu \
            binutils-aarch64-linux-gnu \
            git \
            wget \
            python3

      - name: Prepare Joker source
        run: |
          set -e

          mkdir -p audit/joker
          mkdir -p audit/reports
          mkdir -p audit/index
          mkdir -p audit/out

          wget -q \
            -O audit/joker/violet-perf_defconfig \
            "https://raw.githubusercontent.com/Joker-V2/kernel_xiaomi_violet/sixteen/arch/arm64/configs/vendor/violet-perf_defconfig"

          test -s audit/joker/violet-perf_defconfig

          echo "Joker defconfig downloaded."

      - name: Syntax check Joker defconfig
        run: |
          set -e

          echo "========================================"
          echo "SYNTAX CHECK"
          echo "========================================"

          python3 - <<'PY'
          from pathlib import Path
          import re
          import sys

          path = Path("audit/joker/violet-perf_defconfig")

          valid = 0
          errors = 0

          for number, raw in enumerate(
              path.read_text(errors="replace").splitlines(), 1
          ):
              line = raw.strip()

              if not line:
                  continue

              if line.startswith("# CONFIG_"):
                  if re.fullmatch(
                      r"# CONFIG_[A-Za-z0-9_]+ is not set",
                      line
                  ):
                      valid += 1
                  else:
                      print(f"SYNTAX ERROR line {number}: {raw}")
                      errors += 1
                  continue

              if line.startswith("CONFIG_"):
                  if "=" not in line:
                      print(f"SYNTAX ERROR line {number}: {raw}")
                      errors += 1
                      continue

                  name, value = line.split("=", 1)

                  if not re.fullmatch(
                      r"CONFIG_[A-Za-z0-9_]+",
                      name
                  ):
                      print(f"SYNTAX ERROR line {number}: {raw}")
                      errors += 1
                      continue

                  if value == "":
                      print(f"SYNTAX ERROR line {number}: {raw}")
                      errors += 1
                      continue

                  valid += 1

          print("")
          print("Valid entries :", valid)
          print("Syntax errors :", errors)

          if errors:
              sys.exit(1)
          PY

          echo "Syntax: PASSED"

      - name: Extract Joker settings
        run: |
          set -e

          python3 - <<'PY'
          from pathlib import Path
          import re

          src = Path("audit/joker/violet-perf_defconfig")
          dst = Path("audit/reports/01_all_296.txt")

          found = []

          for line in src.read_text(errors="replace").splitlines():
              line = line.strip()

              if re.fullmatch(
                  r"CONFIG_[A-Za-z0-9_]+=.*",
                  line
              ):
                  found.append(line)

              elif re.fullmatch(
                  r"# CONFIG_[A-Za-z0-9_]+ is not set",
                  line
              ):
                  found.append(line)

          found = sorted(set(found))

          dst.write_text("\n".join(found) + "\n")

          print("Joker settings:", len(found))
          PY

      - name: Build fast Kconfig index
        run: |
          set -e

          echo "========================================"
          echo "BUILDING KCONFIG INDEX"
          echo "========================================"

          python3 - <<'PY'
          from pathlib import Path
          import re

          root = Path(".")
          out = Path("audit/index/kconfig_symbols.txt")

          results = []

          for path in root.rglob("Kconfig*"):

              if ".git" in path.parts:
                  continue

              if not path.is_file():
                  continue

              try:
                  lines = path.read_text(
                      errors="ignore"
                  ).splitlines()
              except Exception:
                  continue

              for number, line in enumerate(lines, 1):

                  m = re.match(
                      r"^\s*(?:config|menuconfig)\s+([A-Za-z0-9_]+)",
                      line
                  )

                  if m:
                      results.append(
                          f"{m.group(1)}|{path}:{number}"
                      )

          results = sorted(set(results))

          out.write_text("\n".join(results) + "\n")

          print("Kconfig symbols:", len(results))
          PY

      - name: Build fast source reference index
        run: |
          set -e

          echo "========================================"
          echo "BUILDING SOURCE INDEX"
          echo "========================================"

          python3 - <<'PY'
          from pathlib import Path
          import re

          root = Path(".")
          out = Path("audit/index/source_references.txt")

          files = []

          skip = {
              ".git",
              "audit",
              "out",
              "joker_test"
          }

          extensions = {
              ".c",
              ".h",
              ".cc",
              ".cpp",
              ".S",
              ".s",
              ".Kconfig",
              ".dts",
              ".dtsi"
          }

          for path in root.rglob("*"):

              if not path.is_file():
                  continue

              if any(part in skip for part in path.parts):
                  continue

              if path.suffix not in extensions:
                  continue

              files.append(path)

          print("Source files:", len(files))

          results = []

          config_re = re.compile(
              r"\bCONFIG_([A-Za-z0-9_]+)\b"
          )

          for path in files:

              try:
                  text = path.read_text(
                      errors="ignore"
                  )
              except Exception:
                  continue

              symbols = set(config_re.findall(text))

              for symbol in symbols:
                  results.append(
                      f"{symbol}|{path}"
                  )

          results = sorted(set(results))

          out.write_text("\n".join(results) + "\n")

          print("Indexed references:", len(results))
          PY

      - name: Generate source and Kconfig reports
        run: |
          set -e

          python3 - <<'PY'
          from pathlib import Path
          import re

          base = Path("audit")
          reports = base / "reports"
          index = base / "index"

          defined = {}
          references = {}

          for line in (index / "kconfig_symbols.txt").read_text(
              errors="ignore"
          ).splitlines():

              if "|" not in line:
                  continue

              symbol, location = line.split("|", 1)

              defined.setdefault(symbol, []).append(location)

          for line in (index / "source_references.txt").read_text(
              errors="ignore"
          ).splitlines():

              if "|" not in line:
                  continue

              symbol, location = line.split("|", 1)

              references.setdefault(symbol, []).append(location)

          all_settings = []

          for raw in (reports / "01_all_296.txt").read_text(
              errors="ignore"
          ).splitlines():

              request = raw.strip()

              if not request:
                  continue

              if request.startswith("CONFIG_"):
                  symbol = request.split("=", 1)[0]
              else:
                  symbol = request[2:].split(" ", 1)[0]

              all_settings.append((symbol, request))

          defined_report = []
          source_report = []
          dependency_report = []
          safe_report = []
          rejected_report = []

          for symbol, request in all_settings:

              name = symbol.replace("CONFIG_", "", 1)

              kconfig_locations = defined.get(name, [])
              source_locations = references.get(name, [])

              defined_report.append(
                  "========================================\n"
                  f"SYMBOL: {symbol}\n"
                  f"REQUEST: {request}\n"
                  f"KCONFIG DEFINITION: "
                  f"{'FOUND' if kconfig_locations else 'NOT FOUND'}\n"
                  + (
                      "\n".join(kconfig_locations[:20])
                      if kconfig_locations else
                      ""
                  )
                  + "\n"
              )

              source_report.append(
                  "========================================\n"
                  f"SYMBOL: {symbol}\n"
                  f"REQUEST: {request}\n"
                  f"SOURCE REFERENCE: "
                  f"{'FOUND' if source_locations else 'NOT FOUND'}\n"
                  + (
                      "\n".join(source_locations[:30])
                      if source_locations else
                      ""
                  )
                  + "\n"
              )

              deps = []

              for path_str in kconfig_locations:

                  file_name, line_number = path_str.rsplit(":", 1)

                  try:
                      lines = Path(file_name).read_text(
                          errors="ignore"
                      ).splitlines()
                  except Exception:
                      continue

                  start = max(0, int(line_number) - 1)

                  context = lines[
                      start:min(len(lines), start + 40)
                  ]

                  for context_line in context:

                      if re.search(
                          r"\b(depends on|select|imply)\b",
                          context_line
                      ):
                          deps.append(
                              f"{file_name}:{context_line.strip()}"
                          )

              deps = sorted(set(deps))

              dependency_report.append(
                  "========================================\n"
                  f"SYMBOL: {symbol}\n"
                  f"REQUEST: {request}\n"
                  f"DEPENDENCY ENTRIES: "
                  f"{len(deps)}\n"
                  + (
                      "\n".join(deps)
                      if deps else
                      "NONE FOUND"
                  )
                  + "\n"
              )

              if kconfig_locations and source_locations:
                  safe_report.append(request)
              else:
                  rejected_report.append(
                      "========================================\n"
                      f"SYMBOL: {symbol}\n"
                      f"REQUEST: {request}\n"
                      f"KCONFIG: "
                      f"{'FOUND' if kconfig_locations else 'NOT FOUND'}\n"
                      f"SOURCE: "
                      f"{'FOUND' if source_locations else 'NOT FOUND'}\n"
                  )

          (reports / "02_defined_in_kconfig.txt").write_text(
              "\n".join(defined_report)
          )

          (reports / "03_source_presence.txt").write_text(
              "\n".join(source_report)
          )

          (reports / "04_dependency_analysis.txt").write_text(
              "\n".join(dependency_report)
          )

          safe_report = sorted(set(safe_report))

          (reports / "05_safe_candidates.txt").write_text(
              "\n".join(safe_report) +
              ("\n" if safe_report else "")
          )

          (reports / "06_rejected.txt").write_text(
              "\n".join(rejected_report) +
              ("\n" if rejected_report else "")
          )

          print("Defined:", sum(
              1 for x in all_settings
              if x[0].replace("CONFIG_", "", 1) in defined
          ))

          print("Source references:", sum(
              1 for x in all_settings
              if x[0].replace("CONFIG_", "", 1) in references
          ))

          print("Potential candidates:", len(safe_report))
          print("Rejected:", len(rejected_report))
          PY

      - name: Kconfig resolution
        run: |
          set -e

          export ARCH=arm64
          export CROSS_COMPILE=aarch64-linux-gnu-

          echo "========================================"
          echo "KCONFIG RESOLUTION"
          echo "========================================"

          make O=audit/out vendor/sdmsteppe-perf_defconfig \
            > audit/reports/kconfig_base.log 2>&1

          cp audit/out/.config audit/out/base.config

          ./scripts/kconfig/merge_config.sh \
            -O audit/out \
            audit/out/base.config \
            audit/joker/violet-perf_defconfig \
            > audit/reports/kconfig_merge.log 2>&1 || true

          test -f audit/out/.config

          make O=audit/out olddefconfig \
            > audit/reports/kconfig_resolve.log 2>&1

          cp audit/out/.config \
            audit/out/resolved.config

          echo "Kconfig resolution: OK"

      - name: Verify final candidates
        run: |
          set -e

          python3 - <<'PY'
          from pathlib import Path

          reports = Path("audit/reports")
          resolved = Path("audit/out/resolved.config").read_text(
              errors="ignore"
          )

          candidates = []

          for line in (reports / "05_safe_candidates.txt").read_text(
              errors="ignore"
          ).splitlines():

              line = line.strip()

              if not line:
                  continue

              if line in resolved:
                  candidates.append(line)

          candidates = sorted(set(candidates))

          (reports / "05_safe_candidates.txt").write_text(
              "\n".join(candidates) +
              ("\n" if candidates else "")
          )

          print("Final Kconfig-resolved candidates:", len(candidates))
          PY

      - name: Generate summary
        run: |
          set -e

          total=$(grep -c '^' audit/reports/01_all_296.txt || true)
          defined=$(grep -c '^SYMBOL:' audit/reports/02_defined_in_kconfig.txt || true)
          source=$(grep -c 'SOURCE REFERENCE: FOUND' audit/reports/03_source_presence.txt || true)
          candidates=$(grep -c '^CONFIG_' audit/reports/05_safe_candidates.txt || true)
          rejected=$(grep -c '^SYMBOL:' audit/reports/06_rejected.txt || true)

          {
            echo "========================================"
            echo "VIOLET FAST DEEP JOKER AUDIT"
            echo "========================================"
            echo
            echo "Joker settings       : $total"
            echo "Kconfig defined      : $defined"
            echo "Source references    : $source"
            echo "Final candidates     : $candidates"
            echo "Rejected             : $rejected"
            echo
            echo "========================================"
            echo "CHECKS"
            echo "========================================"
            echo
            echo "Syntax check         : PASSED"
            echo "Kconfig index        : BUILT"
            echo "Source index         : BUILT"
            echo "Dependency scan      : PERFORMED"
            echo "Kconfig resolution   : PERFORMED"
            echo "Kernel build         : NOT PERFORMED"
            echo
            echo "violet.config        : NOT MODIFIED"
            echo
            echo "========================================"
          } > audit/reports/07_summary.txt

          cat audit/reports/07_summary.txt

      - name: Upload seven reports
        uses: actions/upload-artifact@v4
        with:
          name: violet-fast-deep-joker-audit
          path: |
            audit/reports/01_all_296.txt
            audit/reports/02_defined_in_kconfig.txt
            audit/reports/03_source_presence.txt
            audit/reports/04_dependency_analysis.txt
            audit/reports/05_safe_candidates.txt
            audit/reports/06_rejected.txt
            audit/reports/07_summary.txt
          if-no-files-found: error
